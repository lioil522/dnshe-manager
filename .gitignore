# Node & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
.wrangler/
dist-node/

# 自建（Docker / 裸机 Node）版的本地目录
# data/   运行期数据：SQLite 数据库与自动生成的 aes.key
# public/ 可选的前端产物拷贝（容器内为 /app/public）
/data/
/public/
# NOTE: 只忽略仓库根目录的 public/。frontend/public/ 是 Vite 的静态资源源目录
#       （Cloudflare _headers、theme-init.js 等靠它拷进 dist），必须入库。

# IDE & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Environment & Local secrets
.env
.env.local
.env.development.local
.env.production.local
*.log
