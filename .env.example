# DNSHE-Manager 自建版环境变量
#
#   cp .env.example .env
#
# 全部留空也能正常启动：登录凭据在首次访问时于登录页自行设置，
# 加密密钥会自动生成并保存到数据卷里的 aes.key。

# ---- 镜像 ----
# 版本。留空即 latest（跟随 main 的最新构建）。想钉在某个发布版本就填版本号，例如 1.2.3。
IMAGE_TAG=

# 镜像地址。留空即 ghcr.io/lioil522/dnshe-manager。
# ⚠️ ghcr.io 在部分网络（尤其大陆）基本拉不动：IPv6 会被重置，IPv4 只有几十 KB/s，
#    而 Docker 的 registry-mirrors 只代理 Docker Hub、对 ghcr.io 无效。这种情况换镜像站：
#      IMAGE_REPO=ghcr.nju.edu.cn/lioil522/dnshe-manager
#    实测同一个摘要、35 秒拉完。fork 后想用自己 CI 的产物，也是改这里。
# 要钉死某一次具体构建，把 docker-compose.yml 的 image 改成 <地址>@sha256:...
#（tag 会移动，摘要不会）。
IMAGE_REPO=

# ---- 加密 ----
# AES-GCM 密钥，用于加密存储 DNSHE 的 API Secret 与 2FA TOTP 密钥。
# 留空则首次启动时自动生成随机密钥并写入 /data/aes.key（推荐，无需手配）。
# ⚠️ 无论哪种方式，这个密钥都必须与数据库一起备份：密钥丢了，库里的
#    API Secret 和 2FA 密钥都解不开，只能重新绑定账号。
AES_KEY=

# ---- 应急后门（可选）----
# 配置后可在忘记密码时用它（静态值或其对应的 TOTP 动态码）直接登录作为兜底。
# 不配置则完全禁用该通道，只认用户名密码 + 2FA。
ADMIN_TOKEN=

# ---- 通知（可选，也可在面板【设置】页里配，面板配置优先）----
# WEBHOOK_TYPE: dingtalk / feishu / wecom / serverchan / custom
WEBHOOK_URL=
WEBHOOK_TYPE=

# ---- CORS（可选）----
# 自建版前后端同源，正常情况下不需要填。
# 只有把前端单独部署到别的域名时，才需要在这里列出允许的来源（逗号分隔）。
ALLOWED_ORIGIN=

# ---- 首次启动自动绑定一个 DNSHE 账号（可选）----
DEFAULT_API_KEY=
DEFAULT_API_SECRET=
DEFAULT_API_ALIAS=

# ---- 定时任务 ----
# 触发时刻按 UTC 计。默认 2:00 UTC = 北京时间 10:00。
CRON_UTC_HOUR=2
CRON_UTC_MINUTE=0
# 填 1 可彻底关闭每日同步与自动续期（只保留手动同步按钮）
DISABLE_CRON=

# ---- 其他 ----
# 容器内日志的时区显示
TZ=Asia/Shanghai
